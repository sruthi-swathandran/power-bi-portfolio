model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["co2_source","Emissions","Country","Year","_Measures"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBIDesktopVersion = 2.137.1102.0 (24.10)

annotation PBI_ProTooling = ["DevMode"]

ref table Emissions
ref table Country
ref table Year
ref table _Measures
ref table 'Baseline Year'

ref cultureInfo en-US

