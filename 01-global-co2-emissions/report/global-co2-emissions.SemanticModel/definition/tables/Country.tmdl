	partition Country = m
		mode: import
		source =
				let
				    Source = co2_source,
				    #"Removed Other Columns" = Table.SelectColumns(Source,{"country", "iso_code"}),
				    #"Removed Duplicates" = Table.Distinct(#"Removed Other Columns"),
				    #"Added Custom" = Table.AddColumn(#"Removed Duplicates", "entity_type", each if [iso_code] <> null and [iso_code] <> "" then "Country"
				else if [country] = "Kosovo" then "Country"
				else if [country] = "World" then "World"
				else if [country] = "International transport" then "International transport"
				else if Text.Contains([country], "(GCP)") or Text.Contains([country], "(Jones et al. 2023)") then "Alternative series"
				else if Text.Contains([country], "income countries") then "Income group"
				else "Region or union"),
				    #"Added Custom1" = Table.AddColumn(#"Added Custom", "is_continent", each List.Contains({"Africa","Asia","Europe","North America","South America","Oceania"}, [country])),
				    #"Changed Type" = Table.TransformColumnTypes(#"Added Custom1",{{"entity_type", type text}, {"is_continent", type logical}})
				in
				    #"Changed Type"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

