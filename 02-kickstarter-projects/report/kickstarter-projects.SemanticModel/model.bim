        "partitions": [
          {
            "name": "Projects",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"D:\\Projects\\power-bi-portfolio\\02-kickstarter-projects\\data\\kickstarter_projects.csv\"),[Delimiter=\",\", Columns=11, Encoding=65001, QuoteStyle=QuoteStyle.None]),",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Promoted Headers\",{{\"ID\", type text}, {\"Name\", type text}, {\"Category\", type text}, {\"Subcategory\", type text}, {\"Country\", type text}, {\"Launched\", type datetime}, {\"Deadline\", type date}, {\"Goal\", Int64.Type}, {\"Pledged\", Int64.Type}, {\"Backers\", Int64.Type}, {\"State\", type text}}),",
                "    #\"Added Custom\" = Table.AddColumn(#\"Changed Type\", \"Launch Date\", each Date.From([Launched])),",
                "    #\"Changed Type1\" = Table.TransformColumnTypes(#\"Added Custom\",{{\"Launch Date\", type date}}),",
                "    #\"Added Custom1\" = Table.AddColumn(#\"Changed Type1\", \"Duration Days\", each Duration.Days([Deadline] - Date.From([Launched]))),",
                "    #\"Changed Type2\" = Table.TransformColumnTypes(#\"Added Custom1\",{{\"Duration Days\", Int64.Type}}),",
                "    #\"Added Conditional Column\" = Table.AddColumn(#\"Changed Type2\", \"Goal Band\", each if [Goal] < 1000 then \"Under $1K\" else if [Goal] < 5000 then \"$1K to $5K\" else if [Goal] < 10000 then \"$5K to $10K\" else if [Goal] < 25000 then \"$10K to $25K\" else if [Goal] < 50000 then \"$25K to $50K\" else if [Goal] < 100000 then \"$50K to $100K\" else \"$100K+\"),",
                "    #\"Added Conditional Column1\" = Table.AddColumn(#\"Added Conditional Column\", \"Goal Band Sort\", each if [Goal] < 1000 then 1 else if [Goal] < 5000 then 2 else if [Goal] < 10000 then 3 else if [Goal] < 25000 then 4 else if [Goal] < 50000 then 5 else if [Goal] < 100000 then 6 else 7),",
                "    #\"Changed Type3\" = Table.TransformColumnTypes(#\"Added Conditional Column1\",{{\"Goal Band Sort\", Int64.Type}})",
                "in",
                "    #\"Changed Type3\""
              ],
              "type": "m"
            }
          }
        ]
      },
