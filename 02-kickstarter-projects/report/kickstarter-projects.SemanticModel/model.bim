        "dataCategory": "Time",
        "lineageTag": "ef42f5ec-96fc-4192-a488-661608efcbd8",
        "partitions": [
          {
            "name": "Date Table",
            "mode": "import",
            "source": {
              "expression": [
                "ADDCOLUMNS(CALENDAR(DATE(2009,1,1), DATE(2018,12,31)),",
                "\"Year\", YEAR([Date]),",
                "\"Quarter\", \"Q\" & QUARTER([Date]),",
                "\"Month Number\", MONTH([Date]),",
                "\"Month\", FORMAT([Date], \"mmm\"),",
                "\"Month Year\", FORMAT([Date], \"mmm yyyy\"),",
                "\"Month Year Sort\", YEAR([Date])* 100 + MONTH([Date]))"
              ],
              "type": "calculated"
            }
          }
        ]
      },
      {
        "name": "Key Measures",
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
