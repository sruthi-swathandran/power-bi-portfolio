				    #"Added Conditional Column1" = Table.AddColumn(#"Added Conditional Column", "Goal Band Sort", each if [Goal] < 1000 then 1 else if [Goal] < 5000 then 2 else if [Goal] < 10000 then 3 else if [Goal] < 25000 then 4 else if [Goal] < 50000 then 5 else if [Goal] < 100000 then 6 else 7),
