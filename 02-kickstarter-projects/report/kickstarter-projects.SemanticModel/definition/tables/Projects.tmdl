	partition Projects = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("D:\Projects\power-bi-portfolio\02-kickstarter-projects\data\kickstarter_projects.csv"),[Delimiter=",", Columns=11, Encoding=65001, QuoteStyle=QuoteStyle.None]),
