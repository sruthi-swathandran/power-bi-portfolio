	column 'Month Year'
		lineageTag: d21b7086-d03b-4b82-a617-5574aa6726e0
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Year]

		annotation SummarizationSetBy = Automatic

	column 'Month Year Sort'
		formatString: 0
		lineageTag: 2be869c3-4a6a-4896-9774-45feb411a797
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Year Sort]

		annotation SummarizationSetBy = User

	partition 'Date Table' = calculated
		mode: import
		source =
				ADDCOLUMNS(CALENDAR(DATE(2009,1,1), DATE(2018,12,31)),
				"Year", YEAR([Date]),
				"Quarter", "Q" & QUARTER([Date]),
				"Month Number", MONTH([Date]),
				"Month", FORMAT([Date], "mmm"),
				"Month Year", FORMAT([Date], "mmm yyyy"),
				"Month Year Sort", YEAR([Date])* 100 + MONTH([Date]))

	annotation PBI_Id = 74d4d97378ea44f8aa9f86e3da8a9ed4

