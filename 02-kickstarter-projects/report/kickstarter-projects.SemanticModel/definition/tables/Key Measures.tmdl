table 'Key Measures'
	lineageTag: 01f11c66-afb6-480e-a5b7-16afe33d5c0f

	measure 'Total Projects' = ```
			COUNTROWS(Projects) 
			```
		formatString: #,0
		lineageTag: 2b7db5d5-10e1-4edd-8dea-0a45bef5eea9

	measure 'Successful Projects' = CALCULATE([Total Projects], Projects[State] = "Successful")
		formatString: 0
		lineageTag: 2a93ec48-f74e-4e16-8e0c-85a83a6bb909

	measure 'Resolved Projects' = CALCULATE([Total Projects], Projects[State] IN {"Successful", "Failed"})
		formatString: 0
		lineageTag: 6013f001-66d5-4fb1-981e-3bff1f6ea666

	measure 'Success Rate' = DIVIDE([Successful Projects],[Resolved Projects])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 9f8f4a54-2ea8-4dc4-b39d-bd40540f3fce

	measure 'Total Pledged' = SUM(Projects[Pledged])
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 1d7b8945-64d8-46ee-81c0-22f4e28f9528

	measure 'Total Backings' = SUM(Projects[Backers])
		formatString: #,0
		lineageTag: 2ab01c4c-1e5f-48b2-8cb4-b6a9bed9a12c

	measure 'Median Goal' = MEDIAN(Projects[Goal])
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: c46f57f6-7e9b-400a-9ff1-b1cc89cb2145

	measure 'Median Pledged' = MEDIAN(Projects[Pledged])
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: a72eec37-0f5a-4740-a4dc-71322d0fa8f4

	measure 'Backings per Project' = DIVIDE([Total Backings], [Total Projects])
		lineageTag: 4edba1ba-2e94-45cd-be94-3ef758dbdc20

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Median Pct of Goal' =
			
			MEDIANX(Projects, DIVIDE(Projects[Pledged], Projects[Goal]))
		formatString: 0%;-0%;0%
		lineageTag: 86fd2f23-4f35-40de-9c7b-2408253f5dc0

	partition 'Key Measures' = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	changedProperty = Name

	annotation PBI_ResultType = Table

